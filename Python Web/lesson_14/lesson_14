3. Запити

SELECT
    tickets.id AS ticket_id,
    users.name AS user_name,
    events.title AS event_title,
    tickets.price
FROM tickets
JOIN users ON tickets.user_id = users.id
JOIN events ON tickets.event_id = events.id;

SELECT
    events.id,
    events.title,
    COUNT(tickets.id) AS tickets_sold
FROM events
JOIN tickets ON events.id = tickets.event_id
GROUP BY events.id, events.title
HAVING COUNT(tickets.id) > 5;

SELECT DISTINCT
    users.id,
    users.name,
    users.email
FROM users
JOIN tickets ON users.id = tickets.user_id
WHERE tickets.price > 500;